{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "roncalphoto",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 5174
    },
    {
      "name": "roncalphoto-local",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:local"],
      "port": 5174
    },
    {
      "name": "photos-worker-local",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/photos",
        "preview",
        "--port",
        "8788",
        "--var",
        "API_URL:http://localhost:8787"
      ],
      "port": 8788
    },
    {
      "name": "photos-worker-prod-api",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/photos", "preview", "--port", "8789"],
      "port": 8789
    }
  ]
}
