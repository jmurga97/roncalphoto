{
  "name": "@roncal/api",
  "description": "RoncalPhoto tRPC API on Cloudflare Workers",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787 --inspector-port 9230",
    "dev:local": "wrangler dev --env local --ip 0.0.0.0 --port 8787 --inspector-port 9230",
    "build": "wrangler types && tsc --noEmit",
    "check": "tsc --noEmit && bun run db:check",
    "deploy": "bun run db:migrate && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && bun scripts/check-db-migrations.ts",
    "db:migrate": "wrangler d1 migrations apply DB_RONCALPHOTO --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB_RONCALPHOTO --local --env local",
    "db:seed:local": "bun run db:migrate:local && wrangler d1 execute DB_RONCALPHOTO --local --env local --file seed/seed-local.sql",
    "db:migrations:list": "wrangler d1 migrations list DB_RONCALPHOTO --remote"
  },
  "dependencies": {
    "@roncal/auth": "workspace:*",
    "@roncal/db": "workspace:*",
    "@trpc/server": "11.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3",
    "@cloudflare/workers-types": "^4.20260502.0"
  },
  "exports": {
    "./router": "./src/trpc/router.ts",
    "./dev-fixtures": "./seed/dev-fixtures.ts"
  }
}
