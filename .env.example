# Frontend build-time overrides (read by both Vite apps from the repo root).
# Without it: dev uses localhost:8787; public production uses roncalphoto-api.murgapja-fee.workers.dev.
# Admin production still defaults to api.murga.ing; set this to the deployed API for both apps.
# VITE_API_URL=http://localhost:8787

# Cloudflare deploy credentials (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID) do not belong here:
# configure them in the Cloudflare dashboard or the CI secret store.
