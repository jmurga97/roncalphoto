{
  "name": "roncalphoto-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:local": "turbo dev:local",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "oxfmt --check . && oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "format": "oxfmt .",
    "test:e2e": "playwright test",
    "db:generate": "bun run --cwd apps/api db:generate --",
    "db:check": "bun run --cwd apps/api db:check",
    "db:migrate:local": "bun run --cwd apps/api db:migrate:local",
    "db:seed:local": "bun run --cwd apps/api db:seed:local",
    "format:check": "oxfmt --check ."
  },
  "packageManager": "bun@1.3.6",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tanstack/eslint-plugin-query": "^5.100.10",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "axe-core": "4.12.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.9.12"
  }
}
