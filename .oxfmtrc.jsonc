{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortImports": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    ".agents",
    ".opencode",
    "dist",
    "node_modules",
    ".astro",
    ".wrangler",
    "apps/*/src/app/route-tree.gen.ts",
    "apps/*/src/app/routeTree.gen.ts",
    "worker-configuration.d.ts",
    "bun.lock",
    "apps/api/migrations/meta/",
  ],
}
